rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // Authentication and roles
    // ------------------------------------------------------------
    // The user's role is stored in users/{uid}.role and must be one of:
    // user, seller, admin.
    // New clients may create only their own basic user document with role=user.
    // Promotion to seller/admin must happen from a trusted server or admin flow.
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.role == 'admin';
    }

    function isSeller() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (userDoc(request.auth.uid).data.role == 'seller'
          || userDoc(request.auth.uid).data.role == 'admin');
    }

    function validRole(role) {
      return role in ['user', 'seller', 'admin'];
    }

    // ------------------------------------------------------------
    // Users
    // ------------------------------------------------------------
    match /users/{uid} {
      // A user can read only their own profile. Admins can read profiles.
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      // A client may create only its own first profile as a normal user.
      // Server-side account creation/promotion should use Admin SDK or a trusted API.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'role', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email;

      // Users may update profile details but cannot change their role or email.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'updatedAt'
        ])
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // Stores
    // ------------------------------------------------------------
    match /stores/{storeId} {
      // Public storefronts may be viewed only when active.
      allow get, list: if resource.data.status == 'active'
        || isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);

      // A seller can create one store owned by their own uid.
      allow create: if isSeller()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ['pending', 'active', 'suspended']
        && request.resource.data.keys().hasOnly([
          'ownerId', 'name', 'slug', 'description', 'logoUrl',
          'status', 'createdAt', 'updatedAt'
        ]);

      // Owners may edit store details but cannot transfer ownership.
      allow update: if isAdmin()
        || (isSeller()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'slug', 'description', 'logoUrl', 'updatedAt'
          ]));

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // Products and inventory
    // ------------------------------------------------------------
    // Product documents must include storeId. The store owner is resolved from
    // stores/{storeId}; this prevents a seller from editing another store's data.
    function ownsStore(storeId) {
      return isSeller()
        && exists(/databases/$(database)/documents/stores/$(storeId))
        && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    function validProductShape() {
      return request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 180
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 2
        && request.resource.data.category.size() <= 80
        && request.resource.data.priceMinor is int
        && request.resource.data.priceMinor > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.status in ['active', 'draft', 'archived'];
    }

    match /products/{productId} {
      // Public catalog queries must include where(status == 'active').
      allow get, list: if resource.data.status == 'active'
        || isAdmin()
        || (isSeller() && ownsStore(resource.data.storeId));

      allow create: if ownsStore(request.resource.data.storeId)
        && request.resource.data.keys().hasOnly([
          'storeId', 'name', 'description', 'category', 'priceMinor',
          'compareAtMinor', 'imageUrl', 'stock', 'status', 'createdAt', 'updatedAt'
        ])
        && validProductShape();

      // Sellers can edit price, description, category, image, status and stock.
      // The store cannot be changed during an update.
      allow update: if isAdmin()
        || (ownsStore(resource.data.storeId)
          && request.resource.data.storeId == resource.data.storeId
          && validProductShape());

      allow delete: if isAdmin() || ownsStore(resource.data.storeId);
    }

    // ------------------------------------------------------------
    // Orders
    // ------------------------------------------------------------
    // An order should contain customerId. For seller-side order access, add
    // sellerId to the order or use a server-side order API. Do not expose every
    // order to every seller from the client.
    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'new';

      allow get: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (isSeller() && resource.data.sellerId == request.auth.uid);

      // Queries must include a matching customerId or sellerId clause.
      // Firestore Rules are not filters, so an unconstrained collection query
      // remains denied even when the caller is authenticated.
      allow list: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (isSeller() && resource.data.sellerId == request.auth.uid);

      // Customers cannot change totals, customer identity, or ownership.
      // Status changes are reserved for admins or the owning seller.
      allow update: if isAdmin()
        || (isSeller()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.totalMinor == resource.data.totalMinor
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.status in [
            'new', 'processing', 'shipped', 'completed', 'cancelled'
          ]);

      allow delete: if isAdmin();

      match /items/{itemId} {
        allow read: if isAdmin()
          || (signedIn()
            && get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid)
          || (isSeller()
            && get(/databases/$(database)/documents/orders/$(orderId)).data.sellerId == request.auth.uid);

        // Items should be created by the trusted order service, not directly
        // by an untrusted browser client.
        allow write: if false;
      }
    }

    // ------------------------------------------------------------
    // Public settings
    // ------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------
    // Deny every unlisted collection by default.
    // ------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
