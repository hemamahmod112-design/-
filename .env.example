# انسخ هذا الملف باسم .env (لا يُرفع أبداً على Git — .env موجود في .gitignore بالفعل)

# رابط الاتصال بقاعدة بيانات MySQL/TiDB
DATABASE_URL="mysql://user:password@host:4000/database?ssl={\"rejectUnauthorized\":true}"

# مفتاح سري طويل وعشوائي لتوقيع جلسات الدخول (JWT).
# غيّره عن أي قيمة قديمة كانت مستخدمة مع Manus OAuth.
# لتوليد قيمة عشوائية: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# اختياري: بريد صاحب المشروع. أول حساب يتسجل في المنصة يترقّى admin تلقائياً
# بغض النظر عن هذه القيمة؛ لو حبيت ترقّي بريد معيّن لاحقاً حتى لو مش أول
# مستخدم، حطه هنا.
OWNER_EMAIL=""

NODE_ENV="production"
